# .env.example — copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ─── Required ────────────────────────────────────────────────────────────────

# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (obtain from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Your personal Telegram user ID — this account becomes the bot admin.
# Find it via @userinfobot or similar.
ADMIN_ID=your_telegram_id_here

# ─── Bot Identity ────────────────────────────────────────────────────────────

# Your bot's @username WITHOUT the @ sign (e.g. my_cool_bot)
BOT_USERNAME=your_bot_username

# Display name used in the bot's prompts and UI
BOT_NAME=Lain

# Numeric bot ID (used to detect replies to the bot). Find via @userinfobot.
BOT_ID=your_bot_numeric_id_here

# ─── Group / Channel ─────────────────────────────────────────────────────────

# Telegram chat/group ID where the bot is deployed (supergroups are negative, e.g. -1001234567890)
GROUP_ID=your_group_chat_id_here

# ─── Scheduler ───────────────────────────────────────────────────────────────

# Timezone for the daily summary cron job (IANA format, e.g. Europe/Moscow)
TIMEZONE=UTC

# Time to send the daily summary (24h format)
SUMMARY_HOUR=20
SUMMARY_MINUTE=0

# ─── Optional / Proxy ────────────────────────────────────────────────────────

# HTTP/SOCKS proxy for restricted networks (comment out if not needed)
# PROXY_URL=http://127.0.0.1:10808

# Override the Gemini API base URL (useful for self-hosted proxies)
# GEMINI_BASE_URL=https://your-proxy.example.com
